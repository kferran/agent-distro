#!/usr/bin/env bash
# cb-ingest [--drain|--dry-run] — apply ADDITIVE, self-declared vault landings
# from finished X-Man reports, leave everything else to Kyle.
#
# WHY THIS EXISTS. Research/ops X-Men are read-only on the vault by design, so a
# finding lands only when someone runs /ingest by hand. That step silently didn't
# happen: on 2026-07-29 three complete reports (one a 47KB RCA) sat unlanded while
# their windows were reaped. Queueing them (cb-reap's queue_ingest) stopped the
# loss; this closes the loop.
#
# WHY IT IS ALLOWED TO WRITE. `99 Meta/specs/2026-07-07-eod-autonomous-routing-design.md`
# already amended "routing stays Kyle's call": high-confidence MECHANICAL routing is
# delegated and reviewed by morning diff. The rubric is `.claude/skills/eod/routing-pass.md:37`
# — auto-apply only when the action is a file move or an ADDITIVE EDIT. The Cerebro
# charter says the same for distillation: "Rewrite (Tier 1) refines the owning page
# … as a vault PR — a diff I scan, not notes I read." So this is Tier 1, not a
# violation: it applies, commits LOCALLY, and never pushes.
#
# WHAT IT WILL NOT DO. No prose integration, no refined-not-appended wiki rewrite,
# no destination guessing, no deletion, no replacement, no push. Those stay human —
# they are judgment, and judgment is exactly what the contract reserves. Anything
# this script cannot apply mechanically is written to the ratify worklist instead.
#
# INPUT CONTRACT — a report declares its own landing in a fenced `cb-ingest` block:
#
#   ```cb-ingest
#   target: 03 Resources/ultron/capabilities/capability-dtcc-submission.md
#   mode: insert-before
#   anchor: ## External integrations
#   ---
#   ## Transmission identifiers
#
#   …finished content, exactly as it should appear…
#   ```
#
# Header lines until a lone `---`, then the literal content. Modes:
#   new-file      target must NOT exist -> create it
#   append        target must exist     -> append to end
#   insert-before target must exist     -> insert before an anchor seen EXACTLY once
# A report may carry several blocks; each is applied or refused independently.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/lib/denylist.sh"     # cb_is_forbidden — shared with cb-distill
CB_HOME="${CB_HOME:-$HOME/.cerebro}"
VAULT="${VAULT_DIR:-$HOME/vault}"
QUEUE="$CB_HOME/logs/ingest-queue"
LOCAL="$(TZ=America/Denver date +%F)"
RATIFY="$VAULT/00 Inbox/$LOCAL-vault-maintenance-ratify.md"

mode=""; dry=""
for a in "$@"; do case "$a" in
  --drain) mode=drain;; --dry-run) mode=drain; dry=1;;
  *) echo "cb-ingest: unknown arg $a" >&2; exit 2;;
esac; done
[ "$mode" = drain ] || { echo "usage: cb-ingest {--drain|--dry-run}" >&2; exit 2; }

# Paths this script must NEVER touch, however a report declares itself. Identity
# and policy files, generated surfaces, other people's records, and anything
# Confidential. A report asking for one of these is a refusal, not an edit.
#
# The list itself moved to `lib/denylist.sh` when cb-distill became the second
# script allowed to write the vault. Unchanged in every case — this is a move,
# not an edit, and cb-ingest.bats pins that.

applied=0; refused=0; refusals=()
note_refusal() { refusals+=("$1"); refused=$(( refused + 1 )); }

# apply_block SLUG REPORT N — extract the Nth cb-ingest block and apply it.
apply_block() {
  local slug="$1"
  local rep="$2"
  local n="$3"
  local blk target mode_ anchor content tmp
  # Fence-depth aware. The old form exited on the FIRST bare ``` while inside the
  # block, so any content carrying its own fenced code block was silently truncated
  # at that inner block's closing fence — and the result still applied cleanly,
  # because a short file is not an error. Measured 2026-08-14: of 9 landings, 3 were
  # cut mid-code-block (jira-reason-for-failure-field.md kept 754 of ~6000 bytes).
  # Now: a ```lang line opens an inner block and the next ``` closes it; only a bare
  # ``` at depth 0 terminates the cb-ingest block.
  # ⚠️ Residual ambiguity, deliberately not papered over: an inner block opened with
  # a BARE ``` (no language) is indistinguishable from the terminator. Reports should
  # give inner blocks a language. The balance check below catches it if they don't.
  blk="$(awk -v want="$n" '
    !inb && /^```cb-ingest[[:space:]]*$/ { c++; if (c==want) { inb=1; depth=0; next } }
    inb {
      if ($0 ~ /^```/) {
        if (depth == 0 && $0 ~ /^```[[:space:]]*$/) { exit }
        if (depth == 0) { depth = 1 } else { depth = 0 }
        print; next
      }
      print
    }
  ' "$rep")"
  [ -n "$blk" ] || return 1
  target="$(printf '%s\n' "$blk" | awk -F': *' '/^target:/{sub(/^target: */,"");print;exit}')"
  mode_="$(printf '%s\n' "$blk" | awk '/^mode:/{sub(/^mode: */,"");print;exit}')"
  anchor="$(printf '%s\n' "$blk" | awk '/^anchor:/{sub(/^anchor: */,"");print;exit}')"
  content="$(printf '%s\n' "$blk" | awk 'f{print} /^---[[:space:]]*$/{f=1}')"

  [ -n "$target" ]  || { note_refusal "$slug block $n: no target declared"; return 0; }
  [ -n "$content" ] || { note_refusal "$slug block $n: empty content"; return 0; }

  # Fence-balance gate. Truncated content is not an error the apply step can see —
  # a short file writes just as cleanly as a complete one — so the ONLY way a cut is
  # caught is by checking here, before anything lands. An odd fence count means the
  # content ends inside a code block, which means it was cut. Refuse rather than
  # write a plausible-looking partial file into the wiki.
  if [ "$(( $(printf '%s\n' "$content" | grep -c '^```') % 2 ))" -ne 0 ]; then
    note_refusal "$slug block $n: unbalanced code fences — content truncated, not applied (give inner blocks a language)"
    return 0
  fi
  if cb_is_forbidden "$target"; then
    note_refusal "$slug block $n: target \`$target\` is on the never-touch list"; return 0
  fi
  local abs="$VAULT/$target"

  case "$mode_" in
    new-file)
      [ -e "$abs" ] && { note_refusal "$slug block $n: new-file but \`$target\` already exists"; return 0; };;
    append|insert-before)
      [ -f "$abs" ] || { note_refusal "$slug block $n: $mode_ but \`$target\` does not exist"; return 0; };;
    *)
      note_refusal "$slug block $n: mode \`${mode_:-<none>}\` is not additive (allowed: new-file|append|insert-before)"; return 0;;
  esac

  # idempotency — if the content's first non-blank line is already in the target,
  # treat it as landed rather than duplicating it
  if [ -f "$abs" ]; then
    local first
    first="$(printf '%s\n' "$content" | grep -m1 -v '^[[:space:]]*$' || true)"
    if [ -n "$first" ] && grep -qxF "$first" "$abs" 2>/dev/null; then
      echo "  = already landed: $slug -> $target"; return 0
    fi
  fi

  if [ "$mode_" = insert-before ]; then
    [ -n "$anchor" ] || { note_refusal "$slug block $n: insert-before with no anchor"; return 0; }
    local hits
    hits="$(grep -cxF "$anchor" "$abs" 2>/dev/null || true)"
    [ "${hits:-0}" -eq 1 ] || {
      note_refusal "$slug block $n: anchor \`$anchor\` matched ${hits:-0}x in \`$target\` (need exactly 1)"; return 0; }
  fi

  if [ -n "$dry" ]; then
    echo "  WOULD apply: $slug -> $target ($mode_)"; applied=$(( applied + 1 )); return 0
  fi

  mkdir -p "$(dirname "$abs")"
  case "$mode_" in
    new-file) printf '%s\n' "$content" > "$abs";;
    append)   { printf '\n'; printf '%s\n' "$content"; } >> "$abs";;
    insert-before)
      tmp="$(mktemp)"
      awk -v anc="$anchor" -v body="$content" '
        $0 == anc && !done { print body; print ""; done=1 }
        { print }
      ' "$abs" > "$tmp"
      mv -f "$tmp" "$abs";;
  esac
  echo "  + applied: $slug -> $target ($mode_)"
  applied=$(( applied + 1 ))
}

# ---- drain the queue ----
[ -f "$QUEUE" ] || { echo "cb-ingest: no queue at $QUEUE — nothing to do"; exit 0; }
touched=()
while IFS= read -r line; do
  [ -n "$line" ] || continue
  case "$line" in *"[ingested-"*) continue;; esac        # already drained
  slug="$(printf '%s' "$line" | awk '{print $2}')"
  rep="$(printf '%s' "$line" | sed -n 's/.*report=\([^ ]*\).*/\1/p')"
  [ -n "$slug" ] || continue
  if [ ! -f "$rep" ]; then
    note_refusal "$slug: report missing at \`$rep\`"; continue
  fi
  nblocks="$(grep -c '^```cb-ingest[[:space:]]*$' "$rep" 2>/dev/null || true)"
  if [ "${nblocks:-0}" -eq 0 ]; then
    note_refusal "$slug: no \`cb-ingest\` block — destination is a judgment call, left for /ingest"
    continue
  fi
  i=1
  while [ "$i" -le "${nblocks:-0}" ]; do apply_block "$slug" "$rep" "$i" || true; i=$(( i + 1 )); done
  touched+=("$slug")
done < "$QUEUE"

# ---- mark drained ----
if [ -z "$dry" ] && [ "${#touched[@]}" -gt 0 ]; then
  tmpq="$(mktemp)"
  while IFS= read -r line; do
    marked="$line"
    for s in ${touched[@]+"${touched[@]}"}; do
      case "$line" in
        *"[ingested-"*) :;;
        *" $s "*) marked="$line [ingested-$LOCAL]";;
      esac
    done
    printf '%s\n' "$marked"
  done < "$QUEUE" > "$tmpq"
  mv -f "$tmpq" "$QUEUE"
fi

# ---- refusals go to the ratify worklist, never silently dropped ----
if [ "${#refusals[@]}" -gt 0 ] && [ -z "$dry" ]; then
  {
    printf '\n## cb-ingest refusals — %s\n\n' "$(TZ=America/Denver date +%FT%H:%M)"
    printf 'Queued findings this pass could NOT apply mechanically. Each needs `/ingest`\n'
    printf 'or a decision; none was applied, none was dropped.\n\n'
    for r in ${refusals[@]+"${refusals[@]}"}; do printf -- '- %s\n' "$r"; done
  } >> "$RATIFY"
fi

# ---- one local commit, never a push ----
if [ -z "$dry" ] && [ "$applied" -gt 0 ]; then
  git -C "$VAULT" add -A -- . >/dev/null 2>&1 || true
  git -C "$VAULT" commit -q -m "cb-ingest: applied $applied declared additive landing(s)

Mechanically applied from finished X-Man reports that declared their own landing in
a \`cb-ingest\` block. Additive only (new-file / append / insert-before with a
unique anchor); nothing rewritten, nothing deleted, nothing pushed. Refusals were
written to the ratify worklist for /ingest.

Rubric: .claude/skills/eod/routing-pass.md (additive-edit delegation).
Queue: \$CB_HOME/logs/ingest-queue" >/dev/null 2>&1 || true
fi

printf 'cb-ingest: %d applied, %d refused (refusals -> %s)\n' \
  "$applied" "$refused" "00 Inbox/$LOCAL-vault-maintenance-ratify.md"
exit 0
