#!/usr/bin/env bash
# scripts/cerebro/cb-reactive-intake — reactive intake watcher for EJA mirrors.
#
# WHAT IT IS. A 15-minute watcher that turns "a PO scheduled a bug" into a
# `status: queued` dev item, so `cb-intake --tick` claims and dispatches it on
# its next tick instead of waiting for a manual triage pass. The deliverable is
# LATENCY on inbound bug work.
#
# ⚠️ IT WATCHES THE EJA MIRROR, NEVER THE RAW ASD BOARD. Product Owners own the
# inbound ASD queue — a boundary deliberately re-established 2026-07-01 when the
# nightly ns-asd-triage process was removed from the roster precisely because it
# had institutionalised eng as the owner of a PO responsibility. **The EJA mirror
# existing IS the signal a PO has already triaged and scheduled the work.** This
# script therefore has no ASD-board query, no ASD assignee parameter, and no way
# to express one — the ASD key is carried only as a dedup/reference key.
#
# THE SPLIT (mirrors cb-watchlist/lib/watchlist.sh). Bash owns the deterministic,
# testable seams: the poll window, the high-water state, the three gates, and the
# dev-item emit. The MCP reads (JQL + per-issue fetch) are LLM work — bash has no
# Jira credentials. The poll agent calls `window`, does the reads, then calls
# `offer` once per candidate and `mark-polled` once at the end.
#
# IT CANNOT DISPATCH. There is no tmux invocation, no network call, and no
# `dispatch-request` string anywhere in this file. The single claiming path stays
# `cb-intake`; this script only ever creates a dev item (`queued` or `drafting`).
# It never transitions, assigns, or comments on any ticket.
#
# Subcommands:
#   --tick                     print the poll window iff due (else silent, exit 0)
#   window                     print "SINCE<TAB>UNTIL" (Jira datetime literals)
#   due                        exit 0 iff the watcher is due to poll
#   offer <flags>              run the three gates and emit the dev item
#   dedup KEY...               exit 0 iff no dev item already tracks any KEY
#   mark-polled [UNTIL_EPOCH]  advance the high-water (successful poll only)
#   record-failure REASON      log an unreachable-Jira poll; high-water unmoved
#   --seed [EPOCH]             seed the high-water (forward-only arming)
#   --status                   print watcher state (last success, failures)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$here/lib/paths.sh"
: "${CB_VAULT:=$HOME/vault}"
: "${CB_RI_STATE:=$CB_HOME/reactive-intake}"
: "${CB_RI_INTERVAL:=900}"        # 15 min — the poll cadence (see the report's cadence decision)
: "${CB_RI_LOOKBACK:=300}"        # window overlap absorbing poll jitter; safe because dedup over-matches
: "${CB_RI_FAIL_ALERT:=4}"        # consecutive failed polls before the tick screams (4 × 15m = 1h blind)
: "${CB_RI_TZ:=America/Denver}"   # Kyle's Jira user timezone — JQL datetime literals are user-tz relative
: "${CB_RI_KYLE:=5cc081d23f65fd0e7ecefb82}"   # Kyle Ferran accountId; gate on id, NEVER display name
: "${CB_RI_REPO:=ultron}"
: "${CB_RI_PROJECT:=edj-annuities-phase2}"

items_dir="$CB_VAULT/00 Inbox"
archive_dir="$CB_VAULT/02 Areas/development/archive/items"
_now() { echo "${CB_NOW:-$(date +%s)}"; }
_log() { mkdir -p "$CB_RI_STATE"; printf '%s %s\n' "$(date -Is)" "$*" >> "$CB_RI_STATE/log"; }
_die() { echo "cb-reactive-intake: $*" >&2; exit 2; }

# ---------------------------------------------------------------- state -----
# The high-water mark is the end of the last SUCCESSFUL poll. A failed poll must
# never advance it: a watcher that silently stops watching is worse than none.
_hw() { cat "$CB_RI_STATE/last_success" 2>/dev/null || true; }
_fails() { cat "$CB_RI_STATE/failures" 2>/dev/null || echo 0; }
_jira_dt() { TZ="$CB_RI_TZ" date -d "@$1" '+%Y/%m/%d %H:%M'; }

# ----------------------------------------------------------- severity map ---
# Jira priority → dev-item `severity:` (the field cb-intake's claim ordering
# reads). An unmapped priority is UNRESOLVED, not guessed — it forces drafting.
_severity_for() {
  case "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" in
    blocker|highest) echo Blocker ;;
    high)            echo High ;;
    medium)          echo Medium ;;
    low|lowest)      echo Low ;;
    *)               echo "" ;;
  esac
}

# ------------------------------------------------------------- domain map ---
# Route to the platform domain layer (02 Areas/platform/<domain>/wiki.md) from
# the mirror's summary. First match wins, most-specific first. NO fallback: an
# unresolved domain forces `drafting` rather than guessing a wiki home onto a
# dispatchable item. The poll agent can override with --domain when it has read
# the ticket body and knows better.
_domain_for() {
  local t; t="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$t" in
    *owner*|*annuitant*|*benefic*|*bene\ *|*trust*|*custodial*|*entity*) echo ownership; return ;;
  esac
  case "$t" in
    *form*|*stamp*|*disclosur*|*lexicon*|*e-sign*|*esign*|*wet\ sign*|*signature*|*pdf*) echo forms; return ;;
  esac
  case "$t" in
    *product*|*ppfa*|*cannex*|*rider*|*glwb*|*eligib*|*premium*|*term\ *) echo products; return ;;
  esac
  case "$t" in
    *funding*|*suitab*|*xml103*|*appsub*|*app\ sub*|*dtcc*|*case\ #*|*case\ status*|*submit*|*timer*|*application*) echo case-flow; return ;;
  esac
  case "$t" in
    *pacific\ life*|*nationwide*|*lincoln*|*prudential*|*massmutual*|*corebridge*|*protective*|*usaa*|*athene*|*carrier*) echo carriers; return ;;
  esac
  echo ""
}

# ------------------------------------------------------------------ slug ----
_slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9._-]\+/-/g; s/^[^a-z0-9]\+//; s/-\+/-/g; s/-$//' | cut -c1-60 \
    | sed 's/-$//'
}

# ----------------------------------------------------------- GATE: DEDUP ----
# Scan EVERY key against EVERY dev item, live AND archived — matching only the
# EJA key silently duplicates (ASD-1144 → bugpush-asd-1144, 2026-07-23). Items
# carry their key in `tickets:`, in `jira:`, in the filename, or only in the
# body prose: of 178 live items, 86 have `tickets:` and 123 have `jira:`, and
# asd-445.md / asd-549.md / asd-903.md carry theirs in the FILENAME. So the scan
# is a whole-file + filename token match. It deliberately OVER-matches (an item
# that merely mentions a key counts as a hit) — bias tight, same as queue.sh:
# a false hold is surfaced and cheap; a silent duplicate is not.
# dedup_hits KEY... — prints "KEY<TAB>path" per hit; exit 1 if any hit.
dedup_hits() {
  local key f base hit=1 d
  for key in "$@"; do
    [ -n "$key" ] || continue
    for d in "$items_dir" "$archive_dir"; do
      [ -d "$d" ] || continue
      for f in "$d"/*.md; do
        [ -f "$f" ] || continue
        base="$(basename "$f")"
        # The leading class ALLOWS a hyphen — dev items embed the key mid-slug
        # (`bugpush-asd-1144-…`), so excluding `-` would miss exactly the case
        # this gate exists for. The trailing `[^0-9]` is what keeps ASD-114 from
        # matching ASD-1144.
        # ⚠️ The body is NOT searched — only the filename and the frontmatter
        # `jira:` / `tickets:` lines, which are the only places a dev item
        # DECLARES what it tracks. Searching the body matched any prose mention
        # and produced false holds: on 2026-08-07 EJA-3599 (4 ASD rows, the
        # highest-payoff item in the T&L sweep) was held because its key appears
        # as prose in three unrelated items, and ASD-1247 was held by
        # `ticket-note-dedup-index.md`, an index file that lists 7 keys and
        # tracks none of them. A held item is silently never queued, so this
        # failed in the invisible direction. Same rule as
        # `.claude/memory/feedback_ground_dev_items_against_jira.md`: read the
        # key from `jira:`/`tickets:`, never from a grep of the whole file.
        if grep -qiE "(^|[^A-Za-z0-9])${key}([^0-9]|$)" <<<"$base" \
           || awk 'NR==1&&/^---/{f=1;next} f&&/^---/{exit} f&&/^(jira|tickets):/' "$f" 2>/dev/null \
              | grep -qiE "(^|[^A-Za-z0-9])${key}([^0-9]|$)"; then
          printf '%s\t%s\n' "$key" "$f"; hit=0
        fi
      done
    done
  done
  return "$hit"
}

# -------------------------------------------------------------------- CLI ---
cmd="${1:-}"; [ -n "$cmd" ] || _die "usage: cb-reactive-intake {--tick|window|due|offer|dedup|mark-polled|record-failure|--seed|--status}"
shift || true

case "$cmd" in

  --seed)
    mkdir -p "$CB_RI_STATE"
    printf '%s' "${1:-$(_now)}" > "$CB_RI_STATE/last_success"
    printf '0' > "$CB_RI_STATE/failures"
    _log "seeded high-water at $(_hw) (forward-only arming)"
    echo "cb-reactive-intake: seeded — forward-only from $(_jira_dt "$(_hw)") $CB_RI_TZ"
    ;;

  due)
    # Never polled → due (the --seed step is what makes arming forward-only).
    hw="$(_hw)"; [ -n "$hw" ] || exit 0
    [ $(( $(_now) - hw )) -ge "$CB_RI_INTERVAL" ]
    ;;

  window)
    # Absolute datetimes, not `-15m` relative: poll jitter with a relative window
    # drops events in the gap. Lookback overlap is safe — dedup over-matches.
    hw="$(_hw)"; [ -n "$hw" ] || hw=$(( $(_now) - CB_RI_INTERVAL ))
    since=$(( hw - CB_RI_LOOKBACK )); until="$(_now)"
    printf '%s\t%s\n' "$(_jira_dt "$since")" "$(_jira_dt "$until")"
    ;;

  --tick)
    # Prints the poll window iff due. Deliberately does NOT touch tmux: the cron
    # prompt runs in a fresh LLM context that does the JQL itself, so there is no
    # nudge to send and no way for this script to ask anything to be dispatched.
    f="$(_fails)"; hw="$(_hw)"
    if [ "$f" -ge "$CB_RI_FAIL_ALERT" ]; then
      printf 'cb-reactive-intake: ⚠️ %s consecutive failed polls — reactive intake is BLIND%s\n' \
        "$f" "${hw:+ since $(_jira_dt "$hw") $CB_RI_TZ}" >&2
    fi
    "$0" due || exit 0
    "$0" window
    ;;

  mark-polled)
    mkdir -p "$CB_RI_STATE"
    printf '%s' "${1:-$(_now)}" > "$CB_RI_STATE/last_success"
    printf '0' > "$CB_RI_STATE/failures"
    _log "poll ok — high-water → $(_jira_dt "$(_hw)")"
    ;;

  record-failure)
    # The high-water is deliberately NOT advanced: the next poll re-covers this
    # window, so an unreachable Jira delays the queue but never drops an event.
    mkdir -p "$CB_RI_STATE"
    printf '%s' $(( $(_fails) + 1 )) > "$CB_RI_STATE/failures"
    hw="$(_hw)"
    _log "poll FAILED (${*:-unspecified}) — consecutive=$(_fails); high-water unmoved${hw:+ at $(_jira_dt "$hw")}"
    echo "cb-reactive-intake: poll failure recorded ($(_fails) consecutive); high-water NOT advanced"
    ;;

  --status)
    hw="$(_hw)"
    printf 'interval:      %ss\n' "$CB_RI_INTERVAL"
    printf 'last success:  %s\n' "${hw:+$(_jira_dt "$hw") $CB_RI_TZ}"
    printf 'consecutive failures: %s (alert at %s)\n' "$(_fails)" "$CB_RI_FAIL_ALERT"
    [ -n "$hw" ] || printf 'NOT SEEDED — run `cb-reactive-intake --seed` to arm forward-only\n'
    ;;

  dedup)
    [ "$#" -gt 0 ] || _die "usage: dedup KEY [KEY...]"
    if dedup_hits "$@"; then exit 1; else exit 0; fi
    ;;

  offer)
    eja=""; asd=""; priority=""; summary=""; domain=""; trigger="new"
    assignee=""; assignee_set=0; assignee_name=""; needs_scoping=0; note=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --eja)            eja="${2:-}"; shift 2 ;;
        --asd)            asd="${2:-}"; shift 2 ;;
        --priority)       priority="${2:-}"; shift 2 ;;
        --summary)        summary="${2:-}"; shift 2 ;;
        --domain)         domain="${2:-}"; shift 2 ;;
        --trigger)        trigger="${2:-}"; shift 2 ;;
        --assignee)       assignee="${2:-}"; assignee_set=1; shift 2 ;;
        --assignee-name)  assignee_name="${2:-}"; shift 2 ;;
        --note)           note="${2:-}"; shift 2 ;;
        --needs-scoping)  needs_scoping=1; shift ;;
        *) _die "offer: unknown flag '$1'" ;;
      esac
    done
    [ -n "$eja" ] || _die "offer: --eja is required"
    grep -qE '^EJA-[0-9]+$' <<<"$eja" || _die "offer: --eja must be an EJA key, got '$eja'"
    [ -z "$asd" ] || grep -qE '^ASD-[0-9]+$' <<<"$asd" || _die "offer: --asd must be an ASD key, got '$asd'"
    case "$trigger" in new|reopened) : ;; *) _die "offer: --trigger must be new|reopened" ;; esac
    # DEFAULT-DENY on the assignee gate: an OMITTED --assignee is a usage error,
    # not "unassigned". A gate that fails open when the caller forgets a flag is
    # not a gate. `--assignee ""` is the explicit way to say unassigned.
    [ "$assignee_set" -eq 1 ] || _die "offer: --assignee is required (pass '' for unassigned) — the live-assignee gate must not fail open"

    mkdir -p "$CB_RI_STATE" "$items_dir" "$CB_HOME/logs"

    # --- GATE 1: DEDUP over every key, live + archive -----------------------
    if hits="$(dedup_hits "$eja" "$asd")"; then
      _log "HOLD dedup $eja${asd:+/$asd} — already tracked: $(tr '\n' ';' <<<"$hits")"
      printf 'HOLD dedup — %s%s is already tracked:\n%s\n' "$eja" "${asd:+ / $asd}" "$hits"
      # Sibling-mirror case: the ASD is covered but this EJA key is new. Two EJA
      # mirrors can legitimately split one ASD (EJA-3953 + EJA-3949 → ASD-1100,
      # 2026-07-28), so this is SURFACED for Kyle, never silently dropped — the
      # loop is supervise-only and must not decide a mirror is redundant.
      if ! grep -q "^$eja	" <<<"$hits"; then
        printf '⚠️ SIBLING MIRROR — only the ASD key matched; %s itself is untracked. This may be a distinct mirror splitting one ASD. Kyle'\''s call: consolidate, or emit it by hand.\n' "$eja"
      fi
      exit 3
    fi

    # --- GATE 2: LIVE-ASSIGNEE, on the EJA MIRROR ONLY ----------------------
    # There is no --asd-assignee flag and never should be: a PO sitting on the
    # ASD does NOT block, and this loop must never read or touch the ASD's
    # assignee. Only unassigned or Kyle passes; a real engineer holds, because
    # reassigning a named engineer's ticket is Kyle's outward-facing call.
    if [ -n "$assignee" ] && [ "$assignee" != "$CB_RI_KYLE" ]; then
      _log "HOLD assignee $eja — mirror assigned to ${assignee_name:-$assignee}"
      printf 'HOLD live-assignee — %s is assigned to %s on the EJA MIRROR; reassignment is Kyle'\''s call. ASD untouched.\n' \
        "$eja" "${assignee_name:-$assignee}"
      exit 4
    fi

    # --- GATE 3: SPEC-GATE --------------------------------------------------
    # Anything not fully derivable is `drafting`, NEVER `queued` + `hold:` —
    # cb-intake does not read `hold:`, so a held-but-queued item dispatches.
    severity="$(_severity_for "$priority")"
    [ -n "$domain" ] || domain="$(_domain_for "$summary")"
    gaps=()
    [ -n "$asd" ]      || gaps+=("no linked ASD key on the mirror — confirm this is a service-desk mirror and not internal-only")
    [ -n "$severity" ] || gaps+=("Jira priority '${priority:-<empty>}' does not map to a severity — set Blocker/High/Medium/Low")
    [ -n "$domain" ]   || gaps+=("domain could not be routed from the summary — pick one of ownership/forms/products/case-flow/carriers")
    [ "$needs_scoping" -eq 0 ] || gaps+=("poll agent flagged the ticket as carrying an unanswered question${note:+: $note}")

    status="queued"; [ "${#gaps[@]}" -eq 0 ] || status="drafting"

    slug="$(_slugify "$(tr '[:upper:]' '[:lower:]' <<<"$eja")-$summary")"
    cb_require_slug "$slug" >/dev/null 2>&1 || _die "offer: derived slug '$slug' is invalid"
    f="$items_dir/$slug.md"
    [ -e "$f" ] && { printf 'HOLD dedup — %s already exists\n' "$f"; exit 3; }

    today="$(TZ="$CB_RI_TZ" date -d "@$(_now)" +%F)"
    tickets="$eja"; [ -z "$asd" ] || tickets="$eja, $asd"
    {
      printf -- '---\nslug: %s\nstatus: %s\ntype: dev-item\ntask_type: code\ncreated: %s\n' "$slug" "$status" "$today"
      printf 'jira: %s\n' "$eja"
      printf 'tickets: [%s]\n' "$tickets"
      [ -n "$domain" ]   && printf 'domain: %s\n' "$domain"
      [ -n "$severity" ] && printf 'severity: %s\n' "$severity"
      printf 'repo: %s\nrelated_project: %s\n' "$CB_RI_REPO" "$CB_RI_PROJECT"
      printf 'source: "cb-reactive-intake — %s EJA mirror detected %s"\n---\n\n' "$trigger" "$today"
      printf '# %s — %s\n\n' "$eja" "$summary"
      printf '**[%s](https://porchsoftware.atlassian.net/browse/%s)**' "$eja" "$eja"
      [ -n "$asd" ] && printf ' ↔ **[%s](https://porchsoftware.atlassian.net/browse/%s)**' "$asd" "$asd"
      printf '\n\n'
      if [ "$trigger" = reopened ]; then
        printf '_Reopened EJA mirror (changelog transition, not a status snapshot). Re-read the ticket for what bounced — the prior fix is on the ticket and the bounce reason is the spec._\n\n'
      else
        printf '_New EJA mirror for a PO-triaged ASD ticket. The mirror existing is the signal the work is scheduled — pull the full ticket context live at build time._\n\n'
      fi
      [ -n "$note" ] && printf '%s\n\n' "$note"
      if [ "$status" = drafting ]; then
        printf '## Open questions\n\n'
        for g in "${gaps[@]}"; do printf -- '- %s\n' "$g"; done
        printf '\n_Held at `drafting` by cb-reactive-intake'\''s spec gate. Resolve the above, then flip to `status: queued` — the hourly `cb-intake --tick` claims from there._\n'
      else
        printf '## Definition of done\n\n'
        printf -- '- Fix per the ticket AC (pull EJA/ASD context live at build time).\n'
        printf -- '- Ship a PR with a clear description AND a validator-runnable manual QA test plan.\n'
        printf -- '- Pause only at the final ship gate for Kyle.\n'
      fi
    } > "$f"

    _log "EMIT $slug ($status) $tickets sev=${severity:-none} domain=${domain:-none} trigger=$trigger"
    printf '%s %s reactive-intake-emitted (%s)\n' "$(date -Is)" "$slug" "$status" >> "$CB_HOME/logs/events" 2>/dev/null || true
    printf '%s %s\n' "$status" "$f"
    ;;

  *) _die "unknown subcommand '$cmd'" ;;
esac
